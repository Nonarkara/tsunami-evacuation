{
  "name": "khao-lak-tsunami-preparedness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/*.test.ts && npm run test:buildings",
    "deploy": "npm test && npm run build && node scripts/check-contrast.mjs && wrangler deploy",
    "test:buildings": "python3 -m unittest discover -s scripts -p 'test_*.py'"
  },
  "dependencies": {
    "@fontsource/jost": "^5.2.0",
    "@fontsource/prompt": "^5.2.7",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "suncalc": "^2.1.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.153.0"
  }
}
