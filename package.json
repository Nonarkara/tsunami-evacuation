{
  "name": "khao-lak-tsunami-preparedness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/*.test.ts && npm run test:buildings",
    "deploy": "npm test && npm run build && node scripts/check-contrast.mjs && wrangler deploy",
    "test:buildings": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "verify:release": "node scripts/check-viewport-evidence.mjs && node scripts/check-banner-evidence.mjs && node scripts/check-served-bytes.mjs",
    "capture:evidence": "python3 tools/viewport/capture.py https://tsunami.nonarkara.org",
    "verify:pagination": "python3 scripts/check-results-pagination.py https://tsunami.nonarkara.org",
    "verify:pages": "python3 tools/viewport/pagefill.py docs/evidence/page-fill/page-fill.json --local dist --port 4191 --fail",
    "verify:realestate": "python3 tools/viewport/realestate.py docs/evidence/page-fill/real-estate.json --local dist --port 4192",
    "release": "npm test && npm run build && node scripts/check-contrast.mjs && npm run verify:pages && wrangler deploy && npm run capture:evidence && npm run verify:release"
  },
  "dependencies": {
    "@fontsource/jost": "^5.2.0",
    "@fontsource/prompt": "^5.2.7",
    "earcut": "^3.2.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "suncalc": "^2.1.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.0",
    "wrangler": "^4.153.0",
    "@types/three": "^0.187.0"
  }
}
